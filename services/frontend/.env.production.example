# FastMedia Downloader - variables publicas para Cloudflare Pages (production).
# Copiar a .env.production y configurar identicas en:
# Cloudflare Dashboard > Pages > tu-proyecto > Settings > Environment variables.
# Se hornean en tiempo de build (NEXT_PUBLIC_*), por lo que deben existir durante 'next build'.

NEXT_PUBLIC_API_URL="https://api.example.com"
NEXT_PUBLIC_MEDIA_URL="https://media.example.com"

# Google AdSense (OPCIONAL): Google prohíbe monetizar sitios que distribuyen
# contenido protegido por copyright. Deja vacío para usar solo SponsorWidget.
# NEXT_PUBLIC_AD_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
# NEXT_PUBLIC_AD_SLOT_HEADER="1234567890"

# Google Analytics GA4 (OPCIONAL): se carga solo si el usuario acepta la
# categoría "analítica" en el banner de cookies. Deja vacío para no emitir nada.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"