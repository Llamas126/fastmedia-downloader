# FastMedia Downloader - Variables de entorno (copiar a .env si se desea sobrescribir)

# Puertos publicados en el host, SOLO en loopback (127.0.0.1).
# El nginx del VPS (api.qbitsglobal.com y media.qbitsglobal.com) proxya
# a esos puertos; nada queda expuesto a internet.
FRONTEND_PORT=3000
API_GATEWAY_PORT=8000
MEDIA_PORT=8001

# URL pública del API Gateway que consume el navegador (bakeada en el build del frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública del subdominio de medios que usa getFileUrl() para descargar el archivo
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000

# Orígenes permitidos por CORS en el API Gateway (lista exacta)
ALLOWED_ORIGINS=http://localhost:3000

# Regex adicional de orígenes permitidos (p. ej. previews de Cloudflare Pages).
# Starlette aplica fullmatch: el patron debe cubrir la URL completa.
ALLOWED_ORIGIN_REGEX=.*\.pages\.dev$

# Archivo de cookies para la API de YouTube (opcional; ayuda en IPs de
# datacenter con anti-bot). Se monta read-only desde ./secrets/cookies.txt.
# Debe ser un export Netscape real (cabecera "# Netscape HTTP Cookie File");
# si el archivo existe pero es invalido, el servicio lo ignora con un warning.
FMD_COOKIES_FILE=/app/secrets/cookies.txt

# ===== Produccion (descomentar en el VPS) =====
# El nginx del host proxya estos dominios; el navegador usa estas URLs.
# NEXT_PUBLIC_API_URL=https://api.qbitsglobal.com
# NEXT_PUBLIC_MEDIA_URL=https://media.qbitsglobal.com
# ALLOWED_ORIGINS=https://fastmedia.qbitsglobal.com

# TTL (minutos) antes de purgar archivos temporales descargados
FILE_TTL_MINUTES=30

# ===== Limites de seguridad y recursos =====
# Jobs de descarga simultaneos en el media-processor (exceder responde 429)
MAX_CONCURRENT_JOBS=3
# Tiempo maximo (min) antes de abortar un job atascado
MAX_JOB_MINUTES=20
# Tamano maximo por archivo descargado (MB)
MAX_FILESIZE_MB=2048
# Rate limiting por IP en el API Gateway (peticiones/minuto general y descargas/minuto)
RATE_LIMIT_PER_MINUTE=60
DOWNLOADS_PER_MINUTE=10
# Tamano maximo del cuerpo de las peticiones (bytes)
MAX_BODY_BYTES=65536
# 1 = desactiva la verificacion TLS de yt-dlp (NO recomendado; solo si un extractor lo exige)
YTDLP_ALLOW_INSECURE_TLS=0
# 1 = permite URLs que apunten a IPs privadas/loopback (desactiva el bloqueo anti-SSRF)
ALLOW_PRIVATE_URLS=0